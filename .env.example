# Copy to .env and fill what you have. Everything is optional: missing keys
# disable a source instead of breaking retrieval.

# Google Fact Check Tools (free key) -> highest-value source, enables source_kind="fact_check"
GOOGLE_FACTCHECK_API_KEY=

# Tavily web search (free tier) -> good general web coverage
TAVILY_API_KEY=

# OpenAlex is keyless; a contact email gets you the polite pool (faster responses)
OPENALEX_MAILTO=team@verifyai.local

# Set to 0 to disable the OpenAlex adapter entirely
ENABLE_OPENALEX=1

# --- Retrieval tuning (optional; empty = the default the code already uses) ---
# These four are read by backend/app/pipeline/verify.py and passed to S2's
# RetrievalConfig. A value that does not parse is ignored and named in the response
# warnings, so a typo here degrades loudly instead of silently doing nothing.
# evidence items kept per claim / per source / per domain (1-20)
S2_TOP_K=6
S2_PER_SOURCE_LIMIT=5
S2_MAX_PER_DOMAIN=2
# seconds a cached source answer stays valid (0-86400)
S2_CACHE_TTL_S=900
# uncomment to persist fetched pages between runs (speeds up a rehearsal);
# leave empty for a cold, honest measurement, or delete the directory
S2_DISK_CACHE_DIR=

# --- S1 claim extraction ---
LLM_PROVIDER=mock
S1_LLM_FALLBACK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=45
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
S1_MIN_CLAIMS=3
S1_MAX_CLAIMS=6
S1_MIN_ARTICLE_WORDS=8
S1_MIN_CLAIM_TOKENS=3
S1_MAX_CLAIM_TOKENS=45
S1_MAX_SENTENCES=120
S1_LEXICAL_RECALL=0.55
S1_CHECK_NUMBERS=true
S1_CHECK_ENTITIES=true
S1_CHECK_HEDGES=true
S1_CHECK_QUALIFIERS=true
S1_DENSE_PROPOSITIONS=true
S1_HTTP_TIMEOUT=15
S1_MAX_DOWNLOAD_BYTES=5242880
S1_MAX_REDIRECTS=5
S1_MIN_ARTICLE_CHARS=200
S1_BLOCKED_HOSTS=
S1_USER_AGENT=VerifyAI-S1/1.0 (+claim-extraction)
SPACY_MODEL=en_core_web_sm

# --- S3 stance analysis + quote verification ---
# auto = try the configured LLM provider, fall back to the deterministic lexical
# analyser and record which one was used in s3_audit. Force "lexicon" for a fully
# offline/graded run, "llm" to require the model (it still fails soft to lexical).
S3_MODE=auto
# wall clock for one claim's LLM analysis; on timeout that claim falls back to lexicon
S3_LLM_TIMEOUT=60

# --- /api/verify evidence path ---
# Leave VERIFY_MODE empty and the UI's mode dropdown decides per request.
# Set it to live | offline | snapshot to PIN every request to that mode (useful to
# force an offline demo) — including /api/verify calls and snapshot replays, so a
# stray value here looks exactly like "the dropdown stopped working". "auto" means
# "no pin", same as leaving it blank.
VERIFY_MODE=
# truthy values (1/true/yes/on) force the no-network / replay paths
VERIFY_OFFLINE=
VERIFY_SNAPSHOT_ONLY=
VERIFY_SNAPSHOT_PATH=data/demo_snapshot.json
# how many page bodies S2 fetches per claim for full-text quote verification;
# 0 disables fetching (snippet-only evidence, which the UI labels as such)
S2_FETCH_FULL_TEXT=3
