# ---------------------------------------------------------------------------
# VerifyAI S1 — Claim Extraction configuration
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Provider: "gemini" (remote) | "ollama" (local) | "mock" (offline, no key)
# Default is mock so the module runs out of the box and tests need no API key.
LLM_PROVIDER=mock

# If the provider fails (network, auth, bad JSON), fall back to the built-in
# deterministic heuristic extractor instead of raising.
S1_LLM_FALLBACK=true

# --- Google Gemini (primary remote provider) -------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=45

# --- Ollama (optional local provider) --------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- Extraction behaviour --------------------------------------------------
S1_MIN_CLAIMS=3
S1_MAX_CLAIMS=6
S1_MIN_ARTICLE_WORDS=8
S1_MIN_CLAIM_TOKENS=3
S1_MAX_CLAIM_TOKENS=45
S1_MAX_SENTENCES=120

# --- Validation thresholds -------------------------------------------------
# Minimum share of a claim's content lemmas that must occur in the article.
S1_LEXICAL_RECALL=0.55
S1_CHECK_NUMBERS=true
S1_CHECK_ENTITIES=true
S1_CHECK_HEDGES=true
S1_CHECK_QUALIFIERS=true

# --- URL fetching / SSRF policy --------------------------------------------
S1_HTTP_TIMEOUT=15
S1_MAX_DOWNLOAD_BYTES=5242880
S1_MAX_REDIRECTS=5
S1_MIN_ARTICLE_CHARS=200
S1_BLOCKED_HOSTS=
S1_USER_AGENT=VerifyAI-S1/1.0 (+claim-extraction)

# --- spaCy -----------------------------------------------------------------
SPACY_MODEL=en_core_web_sm
