# Normalize text files in Git while keeping binary files untouched.
* text=auto

# Windows scripts must be CRLF on checkout, whatever each member's autocrlf says
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else: LF for stable diffs across platforms
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.zip binary
*.png binary

# The React UI ships media; `text=auto` detects these as binary today (they contain NUL
# bytes), but an explicit rule means a checkout can never CRLF-expand a video into junk.
*.mp4 binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.ico binary
