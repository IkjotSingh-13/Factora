# Line endings: PowerShell and batch files must be CRLF on Windows checkouts,
# regardless of each member's core.autocrlf setting. Without this, a Windows
# clone with core.autocrlf=true commits these as LF and Notepad shows one long line.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Python and markdown: LF everywhere (stable diffs across platforms)
*.py text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Binary / generated - never diff or convert
*.zip binary
*.png binary
*.jpg binary
